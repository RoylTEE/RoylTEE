---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import '../styles/landing.css';
import { UPDATES } from '../data/updates';

const day = (iso: string) => iso.slice(0, 10);
const when = (u: { at: string; dateOnly?: boolean }) => (u.dateOnly ? u.at : `${u.at.slice(0, 10)} ${u.at.slice(11, 16)} UTC`);
const groups = [...new Set(UPDATES.map((u) => day(u.at)))].map((d) => ({ d, items: UPDATES.filter((u) => day(u.at) === d) }));
---
<Base current="learn" title="Updates . RoylTEE" description="A dated changelog of what was built and deployed for RoylTEE, in UTC, each entry linked to its transaction or document.">
  <PageHero art="hdr-updates" alt="Flat retro illustration: a radio tower on a cliff at dusk sending rings of signal and a cassette tape across the sky." eyebrow="Updates" title="What was built, and when" intro="A dated record of the build, taken from the git history, the decisions log and the transactions on testnet. All times are UTC." />

  <section class="p-sec">
    <div class="container">
      {groups.map((g) => (
        <div class="day" id={`d-${g.d}`}>
          <h2 class="dayh mono">{g.d}</h2>
          <ol class="log">
            {g.items.map((u) => (
              <li>
                <div class="meta"><span class="mono when">{when(u)}</span><span class="badge info">{u.kind}</span>{u.simulated && <span class="badge sim">Simulated</span>}</div>
                <div class="what">
                  <h3>{u.title}</h3>
                  <p>{u.body}</p>
                  <p class="links">{u.links.map((l) => <a class="l-textlink" href={l.href} {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}>{l.label}</a>)}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      ))}
      <p class="p-note">Chain times come from the recorded transactions. Repository times are commit times. Nothing on this page is an announcement: it lists build steps only.</p>
    </div>
  </section>
</Base>
<style>
  .day { display: grid; grid-template-columns: 9rem 1fr; gap: var(--s5); padding: var(--s6) 0; border-top: 1px solid var(--rule); }
  .day:first-child { border-top: 0; padding-top: 0; }
  .dayh { font-size: var(--fs-18); font-weight: 700; position: sticky; top: 5rem; align-self: start; }
  .log { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s4); }
  .log li { display: grid; grid-template-columns: 11rem 1fr; gap: var(--s4); padding: var(--s4) var(--s5); background: var(--surface); border: 1px solid var(--edge); border-radius: var(--r-card); box-shadow: var(--shadow-1); min-width: 0; }
  .meta { display: flex; flex-wrap: wrap; gap: var(--s2); align-items: center; align-content: start; }
  .when { font-size: var(--fs-12); color: var(--dim); width: 100%; }
  .what { display: grid; gap: var(--s2); min-width: 0; }
  .what h3 { font-size: var(--fs-16); font-weight: 600; line-height: 1.3; }
  .what p { font-size: var(--fs-14); line-height: 1.6; color: var(--muted); }
  .links { display: flex; flex-wrap: wrap; gap: var(--s2) var(--s4); }
  @media (max-width: 899px) { .day { grid-template-columns: 1fr; gap: var(--s3); } .dayh { position: static; } .log li { grid-template-columns: 1fr; gap: var(--s2); padding: var(--s4); } }
</style>
