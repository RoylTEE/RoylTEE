---
import App from '../layouts/App.astro';
import PowerTable from '../components/PowerTable.astro';
import { SCENES, categoriesOf } from '../data/testnet';
const controls: [string, string, string, string][] = [
  ['grant_role', 'Give a sub-account a payment role', 'Organisation must be an active member; agent is its direct sub-account with no credential and not a payer; 0 < per payment <= daily; 1 to 1000 payments a day; expiry in the future', 'The role storage cost, measured in the call; the rest of the deposit buys statement lines at 0.001 NEAR each'],
  ['add_line_credits', 'Prepay statement lines', "Only the agent's organisation; at least one line", '0.001 NEAR per line'],
  ['revoke_role', 'Kill switch, takes effect at once', 'The organisation or the registrar; not already revoked. The allowance stays withdrawable', '1 yoctoNEAR'],
  ['withdraw_allowance', 'Take unused Mock USDC back', "Only the agent's organisation, not suspended; up to the allowance left", '1 yoctoNEAR'],
];
const n = SCENES.filter((s) => categoriesOf(s).includes('agent')).length;
---
<App area="agents" title="Agents" intro="Software that pays for music. Each agent spends from a capped allowance, names a work, and never picks the payee.">
  <div data-agents><p class="loading">Reading testnet</p></div>
  <section class="panel" id="controls" aria-labelledby="ctl-h">
    <div class="panel-head"><h2 id="ctl-h">Agent controls</h2><span class="end"><span class="badge warn">Needs the org wallet</span></span></div>
    <div class="table-wrap">
      <table class="ledger rows-sm">
        <thead><tr><th>Control</th><th>What it does</th><th>Limits the contract enforces</th><th>Attaches</th></tr></thead>
        <tbody>
          {controls.map(([m, what, lim, dep]) => <tr><td class="p mono small">{m}</td><td class="p-wrap">{what}</td><td class="m wrap">{lim}</td><td class="x mono small">{dep}</td></tr>)}
        </tbody>
      </table>
    </div>
    <div class="panel-body stack">
      <p class="small">Every control is signed by the label or publisher that owns the agent, never by the agent: its only key is a function call key, which cannot attach the deposit these methods need. Signing opens on Your shares, the one page that loads the wallet selector, so this page keeps the strict policy.</p>
      <div class="actions"><a class="btn primary" href="/member?account=buyer-pub.royltee-dev.testnet#org">Open the agent controls</a><span class="badge unv">UNVERIFIED</span></div>
      <p class="caption">Sending these from the site has not been run on testnet yet. The recorded role was granted outside this site.</p>
    </div>
  </section>
  <section class="panel" aria-labelledby="org-h">
    <div class="panel-head"><h2 id="org-h">What the organisation can do</h2><span class="caption">Signed by the label or publisher that granted the role, never by the agent</span></div>
    <PowerTable who="organisation" />
  </section>
  <a class="next-card" href="/activity#agent"><span><strong>Agent activity</strong><span class="small muted">{n} recorded steps, including the refused second submit of one statement line</span></span><span class="badge plain">Activity</span></a>
  <p class="caption">Also refused, with no transaction: the agent claim on s4 with 1 yoctoNEAR. A function call key cannot attach a deposit, so the protocol stops it before it is sent. This was seen in a local CLI log only, so there is no explorer link to check.</p>
</App>
<script>import '../scripts/agents.ts';</script>
<style is:global>
  .agent-grid { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: var(--s5); align-items: start; }
  .meter { display: grid; gap: .4rem; }
  .meter-top { display: flex; justify-content: space-between; gap: var(--s3); font-size: var(--fs-14); }
  .meter-bar { height: .5rem; border-radius: 3px; background: var(--paper-2); border: 1px solid var(--rule); overflow: hidden; }
  .meter-bar > span { display: block; height: 100%; background: var(--ink); }
  .method-list { display: flex; flex-wrap: wrap; gap: var(--s2); }
  .method { font-family: var(--mono); font-size: var(--fs-14); padding: .2rem .5rem; border-radius: var(--r-ctl); border: 1px solid var(--ok-line); background: var(--ok-bg); color: var(--ok); }
  .method.no { border-color: var(--bad-line); background: var(--bad-bg); color: var(--bad); text-decoration: line-through; }
  .next-card { display: flex; justify-content: space-between; align-items: center; gap: var(--s4); min-height: 3.5rem; padding: var(--s3) var(--s5); border: 1px solid var(--edge); border-radius: var(--r-card); background: var(--surface); text-decoration: none; box-shadow: var(--shadow-1); }
  .next-card > span:first-child { display: grid; }
  .next-card:hover { background: var(--surface-2); }
  @media (max-width: 1199px) { .agent-grid { grid-template-columns: 1fr; } }
  @media (max-width: 767px) { .agent-grid .kv { grid-template-columns: 1fr 1fr; } }
</style>
