---
import App from '../layouts/App.astro';
/* Rendered per request so the wallet selector gets a fresh CSP nonce (src/middleware.ts). */
export const prerender = false;
---
<App area="help" tab="chat" title="Help" intro="Ask the guide about shares, share accounts, payments and the demo. For anything about your account, open a support ticket." period={false} description="Ask the help guide or contact support with a NEAR testnet wallet.">
    <section class="panel" id="chat" data-tab-panel aria-labelledby="chat-h">
      <div class="panel-head"><h2 id="chat-h">Help chat</h2><div class="end"><button type="button" class="btn sm" data-chat-reset>New chat</button></div></div>
      <div class="panel-body">
        <div class="chat-log" data-chat-log aria-live="polite"></div>
        <form data-chat-form class="stack">
          <div class="field">
            <label for="chat-input">Your question</label>
            <textarea id="chat-input" name="message" maxlength="1500" rows="3" placeholder="For example: what happens to unclaimed money when a share is sold?" required></textarea>
          </div>
          <div class="actions"><button class="btn primary" type="submit">Ask</button><span class="small muted" data-chat-status></span></div>
        </form>
      </div>
      <p class="panel-foot">Use demo details only. This site does not store chat text. Answers can be wrong; the repository docs are the source of truth. A reply shows a TEE label only when NEAR AI Cloud reports signature_kind provider_tee for it. Attestation is not verified by this app, and the contracts use no TEE.</p>
    </section>
    <section class="panel" id="support" data-tab-panel data-support data-state="out" aria-labelledby="sup-h">
      <div class="panel-head"><h2 id="sup-h">Contact support</h2></div>
      <div class="panel-body">
        <p class="small">Sign in with a NEAR wallet to open a ticket. No email and no personal data. Your wallet signs a message, never a transaction. A sign in lasts 15 minutes.</p>
        <div class="out-only"><button type="button" class="btn primary" data-sign-in>Sign in with NEAR wallet</button></div>
        <div class="in-only stack">
          <div class="actions"><span class="mono small" data-who></span><button type="button" class="btn sm" data-sign-out>Sign out</button></div>
          <form data-ticket-form class="stack">
            <div class="field"><label for="t-subject">Subject</label><input id="t-subject" name="subject" maxlength="120" required /></div>
            <div class="field"><label for="t-message">Message</label><textarea id="t-message" name="message" maxlength="2000" rows="5" required></textarea>
              <p class="hint">Never include a seed phrase, private key, email address, phone number or card number. The form refuses anything that looks like one.</p></div>
            <div><button class="btn primary" type="submit">Send ticket</button></div>
          </form>
          <h3 class="sub-h">Your tickets</h3>
          <ul class="tickets" data-tickets></ul>
        </div>
        <p class="small muted" data-support-status aria-live="polite"></p>
      </div>
      <p class="panel-foot">Tickets live in private server storage, tied only to your wallet account id. They are never on chain or in logs. Open tickets expire 30 days after the last update. Closed tickets are deleted 30 days after they close.</p>
    </section>
</App>
<script>import '../scripts/help.ts';</script>
<style is:global>
  #chat, #support { max-width: 56rem; }
  .chat-log { display: grid; gap: var(--s3); max-height: 30rem; overflow: auto; }
  .chat-log:empty { display: none; }
  .turn { padding: var(--s3) var(--s4); border-radius: var(--r-ctl); border: 1px solid var(--rule); background: var(--surface-2); display: grid; gap: .25rem; }
  .turn.user { background: var(--amber-tint); border-color: var(--warn-line); margin-left: 3rem; }
  .turn .who { font-size: var(--fs-12); font-weight: 600; color: var(--muted); }
  .turn .tee { font-size: var(--fs-12); }
  .turn a, .reply a { text-decoration: underline; }
  .sub-h { font-size: var(--fs-18); margin-top: var(--s2); }
  [data-state="out"] .in-only, [data-state="in"] .out-only { display: none; }
  .tickets { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--s3); }
  .ticket { border: 1px solid var(--rule); border-radius: var(--r-ctl); padding: var(--s4); display: grid; gap: var(--s2); background: var(--surface-2); }
  .ticket-head { display: flex; justify-content: space-between; align-items: center; gap: var(--s3); }
  .reply { border-left: 3px solid var(--amber); padding-left: var(--s3); }
  .ticket .row { display: flex; gap: var(--s2); flex-wrap: wrap; }
  @media (max-width: 991px) { .turn.user { margin-left: 1rem; } }
</style>
