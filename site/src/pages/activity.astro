---
import App from '../layouts/App.astro';
import ActivityTable from '../components/ActivityTable.astro';
import { SCENES, categoriesOf } from '../data/testnet';
const refusedNoTx = 'Also refused, with no transaction: the agent claim on s4 with 1 yoctoNEAR. A function call key cannot attach a deposit, so the protocol stops it before it is sent. This was seen in a local CLI log only, so there is no explorer link to check.';
const count = (k: string) => SCENES.filter((s) => categoriesOf(s).includes(k)).length;
---
<App area="activity" tab="all" title="Activity" intro="The recorded on-chain demo, newest first. Every row links to its transaction on the explorer." period={false}>
  <section class="panel" aria-labelledby="act-h">
    <div class="panel-head"><h2 id="act-h">Recorded activity</h2><span class="caption">{SCENES.length} steps on 2026-11-13 (UTC). Payments {count('payments')}, claims {count('claims')}, agent {count('agent')}, dispute {count('dispute')}, refused {count('refused')}.</span></div>
    <ActivityTable id="acts" collapsible />
    <div class="panel-foot">{refusedNoTx} Full event history per share is in each transaction's logs (NEP-297 events, standard share_registry). A view by statement period needs an event indexer, which is roadmap.</div>
  </section>
</App>
