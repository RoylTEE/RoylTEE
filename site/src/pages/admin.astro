---
import Base from '../layouts/Base.astro';
import { PROJECT_NAME } from '../consts';
import { loadConfig, storeFor } from '../server/config';
import { readSession } from '../server/auth';
import { cookie } from '../server/security';
import { SESSION_COOKIE } from '../server/api';
export const prerender = false;
const config = loadConfig(process.env);
let permitted = false;
try {
  const session = readSession(config.sessionSecret, cookie(Astro.request, SESSION_COOKIE), Date.now());
  permitted = !!config.adminWallet && session.wallet === config.adminWallet && await storeFor(config)?.get(`session:${session.sid}`) === session.wallet;
} catch { /* The sign in shell contains no ticket data. */ }
Astro.response.status = permitted ? 200 : 401;
Astro.response.headers.set('Cache-Control', 'private, no-store');
---
<Base title={`Support admin . ${PROJECT_NAME}`} description="Support owner page.">
  <section class="help pad">
    <div class="help-in">
      <h1>Support admin</h1>
      <div class="panel" data-admin data-permitted={String(permitted)} data-state={permitted ? "in" : "out"}>
        <p>Only the support owner wallet can read tickets here. The server checks the wallet on every request.</p>
        <div class="row out-only"><button type="button" class="btn no-chip dark" data-sign-in>Sign in with NEAR wallet</button></div>
        <div class="in-only row"><button type="button" class="btn no-chip outline" data-sign-out>Sign out</button></div>
        <p class="muted small" data-admin-status aria-live="polite"></p>
        <ul class="tickets" data-admin-list></ul>
      </div>
    </div>
  </section>
</Base>
<script>import '../scripts/admin.ts';</script>
<style is:global>
  .help { padding-top: 7rem; padding-bottom: 8rem; }
  .help-in { max-width: 46rem; margin: 0 auto; display: grid; gap: 1.5rem; }
  .panel { background: #fff; border: 1px solid var(--line); border-radius: 20px; padding: 1.5rem; display: grid; gap: 1rem; }
  .row { display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; }
  .panel textarea { width: 100%; font: inherit; padding: .75rem; border: 1px solid var(--line); border-radius: 12px; }
  .small { font-size: .85rem; }
  [data-state="out"] .in-only, [data-state="in"] .out-only { display: none; }
  .tickets { list-style: none; padding: 0; margin: 0; display: grid; gap: .75rem; }
  .ticket { border: 1px solid var(--line); border-radius: 12px; padding: 1rem; display: grid; gap: .5rem; }
  .ticket-head { display: flex; justify-content: space-between; gap: 1rem; }
  .reply { border-left: 3px solid var(--amber); padding-left: .75rem; }
</style>
