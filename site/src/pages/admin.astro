---
import App from '../layouts/App.astro';
import { loadConfig, storeFor } from '../server/config';
import { readSession } from '../server/auth';
import { sessionCookie } from '../server/security';
import { recordWallet } from '../server/auth';
export const prerender = false;
const config = loadConfig(process.env);
let permitted = false;
try {
  if (!config.sessionSecret || !config.adminWallet) {
    permitted = false;
  } else {
    const session = readSession(config.sessionSecret, sessionCookie(Astro.request), Date.now());
    const record = recordWallet(await storeFor(config)?.get(`session:${session.sid}`));
    const pin = config.adminPublicKey;
    const keyOk = !pin || record?.publicKey === pin;
    permitted = !!record && record.wallet === session.wallet && session.wallet === config.adminWallet && keyOk;
  }
} catch { /* The sign in shell contains no ticket data. */ }
Astro.response.status = permitted ? 200 : 401;
Astro.response.headers.set('Cache-Control', 'private, no-store');
---
<App area="help" title="Support admin" crumb="Support admin" intro="Only the support owner wallet can read tickets here. The server checks the wallet on every request." period={false} description="Support owner page.">
  <div class="admin-wrap">
    <section class="panel" data-admin data-permitted={String(permitted)} data-state={permitted ? "in" : "out"} aria-labelledby="q-h">
      <div class="panel-head"><h2 id="q-h">Ticket queue</h2><div class="end"><span class="out-only"><button type="button" class="btn primary" data-sign-in>Sign in with NEAR wallet</button></span><span class="in-only"><button type="button" class="btn sm" data-sign-out>Sign out</button></span></div></div>
      <div class="panel-body">
        <p class="small muted" data-admin-status aria-live="polite"></p>
        <ul class="tickets" data-admin-list></ul>
      </div>
    </section>
  </div>
</App>
<script>import '../scripts/admin.ts';</script>
<style is:global>
  .admin-wrap { max-width: 56rem; }
  [data-state="out"] .in-only, [data-state="in"] .out-only { display: none; }
  .tickets { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--s3); }
  .tickets > .muted { padding: var(--s5); border: 1px dashed var(--edge); border-radius: var(--r-card); background: var(--surface-2); }
  .ticket { border: 1px solid var(--rule); border-radius: var(--r-ctl); padding: var(--s4); display: grid; gap: var(--s2); background: var(--surface-2); }
  .ticket-head { display: flex; justify-content: space-between; align-items: center; gap: var(--s3); }
  .reply { border-left: 3px solid var(--amber); padding-left: var(--s3); }
  .ticket .row { display: flex; gap: var(--s2); flex-wrap: wrap; }
</style>
