---
import Base from '../layouts/Base.astro';
import { DASHBOARD_URL, WHITEPAPER_URL, SOURCE_URL, PROJECT_NAME } from '../consts';
const arrow = `<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 8h10M9 4l4 4-4 4"/></svg>`;
const updates = [1, 2, 3, 4, 5];
const logos = [1, 2, 3, 4, 5, 6];
const problems = [
  { img: 'split', t: 'Many owners per song', d: 'A song is split among writers, publishers, labels and others. Each share has its own owner, and each share can be sold.' },
  { img: 'records', t: 'Records that disagree', d: 'Who owns which share is kept in separate databases that do not always agree, so a payer often cannot tell whom to pay.' },
  { img: 'transfer', t: 'Shares change hands', d: 'When a share is sold, every payer has to learn the new payee. Until they do, money can land in the wrong place.' },
  { img: 'agent', t: 'Software pays too', d: 'When an agent pays for music, it needs a payee it cannot get wrong and a budget it cannot go over.' },
];
const compare = [
  ['Payee', 'Each payer keeps its own list', 'Fixed by the work on record'],
  ['After a sale', 'Every payer updates its records', 'Nothing changes for payers'],
  ['Splits', 'Worked out by each payer', 'Split by basis points on chain'],
  ['Rounding', 'Each payer picks a rule', 'One public rule, sums exactly'],
  ['Agents', 'Broad payment access', 'Capped allowance, no payee choice'],
];
const steps = [
  { n: '01', t: 'Pay once', d: 'A payer sends Mock USDC once, naming the work. The payment carries the payer, the period and a statement hash.' },
  { n: '02', t: 'Split to vaults', d: 'The registry splits by basis points and forwards each part straight into a share vault. The parts add up to the payment exactly.' },
  { n: '03', t: 'Claim', d: 'Whoever holds the share token can claim what its vault holds. Nobody else can, and the vault has no keys to steal.' },
  { n: '04', t: 'Catalog sale', d: 'Selling a share moves the token. The vault address stays the same, so payers change nothing. Only the controller changes.' },
];
const vaults = ['share-1', 'share-2', 'share-3', 'share-4', 'share-5'];
const agentTabs = [
  { t: 'A cap the owner sets', d: 'An agent spends only from an allowance its owner sets. When the cap is used up, its payments stop until the owner tops it up.' },
  { t: 'The agent never picks the payee', d: 'An agent names the work and the amount. The registry decides where the money goes, using the splits on record.' },
  { t: 'Locks that cannot freeze a vault', d: 'A payout in flight locks its vault so a transfer cannot race it. A stale lock can be released, so one failed call does not freeze a vault for good.' },
  { t: 'Every move is an event', d: 'Payments, claims, transfers and registrar actions each emit an event that anyone can read and check.' },
];
const life = [
  { n: '01', t: 'Register the work', d: 'A work is recorded with its ISRC or ISWC. A duplicate code is refused and opens a dispute.' },
  { n: '02', t: 'Mint the shares', d: 'Each share is a token with basis points for one right and territory. Over 100 percent is refused.' },
  { n: '03', t: 'Pay', d: 'Known shares are paid. Any unassigned part waits in escrow that only the registrar can release, with a document hash.' },
  { n: '04', t: 'Claim', d: 'The holder claims from the vault. A transfer cannot land while a payout is in flight.' },
  { n: '05', t: 'Sell', d: 'The token moves to the buyer. The payout address does not change. The next payment goes to the new holder.' },
  { n: '06', t: 'Dispute', d: 'Contested money is held, not guessed. The registrar resolves it with a document hash and an event.' },
];
const trust = [
  { t: 'Zero key vaults', d: 'Vaults have no access keys. Only the registry contract can move money out, and only to the current holder.', icon: 'key' },
  { t: 'A registrar with limits', d: 'Every registrar power needs a document hash and emits an event. The registrar cannot claim a share, sweep funds or change the contract.', icon: 'scale' },
  { t: 'Disputes hold money', d: 'Contested money waits for a decision. A suspended share keeps earning but cannot be claimed or moved by its holder.', icon: 'pause' },
  { t: 'Statements stay private', d: 'Royalty statements stay off chain. Only a hash of the statement travels with the payment.', icon: 'lock' },
];
const resources = [
  { k: 'Whitepaper', f: 'PDF', t: 'The design, the mechanism and why it works', href: WHITEPAPER_URL },
  { k: 'Dashboard', f: 'App', t: 'Open the NEAR testnet dashboard', href: DASHBOARD_URL },
  { k: 'Source', f: 'Code', t: 'Read the contracts and tests', href: SOURCE_URL },
  { k: 'Video', f: 'Video', t: 'Watch the catalog sale scene', href: '#video-placeholder' },
];
const quotes = [1, 2, 3];
---
<Base>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-art" aria-hidden="true">
      <img src="/placeholder-hero.svg" alt="" data-parallax />
      <div class="hero-shade"></div>
    </div>
    <div class="hero-body container pad">
      <span class="tag-sim hero-tag" data-hero-fade>Simulated demo</span>
      <h1 class="hero-h" data-hero-split>
        <span class="hero-strong">The verified payout address</span>
        <span class="hero-light">for every share of every song, human or AI.</span>
      </h1>
      <p class="hero-sub" data-hero-fade>Pay a work once. The registry splits it by basis points into share vaults that hold no keys. Whoever holds the share claims it.</p>
      <div class="hero-ctas" data-hero-fade>
        <a class="btn dark" href={DASHBOARD_URL}>Open testnet dashboard <span class="chip" set:html={arrow} /></a>
        <a class="link-arrow hero-link" href={WHITEPAPER_URL}><span class="link-line">Read the whitepaper</span><Fragment set:html={arrow} /></a>
      </div>
    </div>
  </section>

  <!-- UPDATES STRIP -->
  <section class="updates">
    <div class="updates-in pad">
      <div class="updates-head">
        <p class="updates-title">Latest updates</p>
        <div class="updates-nav">
          <button class="sq" aria-label="Previous" data-up-prev><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M13 8H3M7 4L3 8l4 4"/></svg></button>
          <button class="sq" aria-label="Next" data-up-next><Fragment set:html={arrow} /></button>
        </div>
      </div>
      <div class="updates-list" data-up-list>
        {updates.map((i) => (
          <a class="up-card" href="#updates-placeholder">
            <div class="up-thumb frame gridbg"><span class="tag-mono">Placeholder</span></div>
            <div class="up-text">
              <p>Update {i} goes here. No news is published yet.</p>
              <span class="link-arrow muted">Read more<Fragment set:html={arrow} /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- LOGO STRIP -->
  <section class="logos sec-md" aria-label="Placeholder logo strip">
    <p class="center logos-h">Placeholder logo strip. <span class="muted">No partners, customers or payers are claimed.</span></p>
    <div class="marquee" data-marquee>
      {[0, 1].map((row) => (
        <div class={`mq-row ${row ? 'rev' : ''}`}>
          {[0, 1].map(() => (
            <div class="mq-track">{logos.map((l) => <img src={`/placeholder-logo-${l}.svg`} alt={`placeholder logo ${l}`} width="160" height="48" />)}</div>
          ))}
        </div>
      ))}
    </div>
  </section>

  <!-- PROBLEM -->
  <section class="problem sec-lg pad" id="problem">
    <div class="container">
      <h2 class="center sec-h" data-split-lines>Every song has many owners.<br /><span class="muted">Every payer keeps its own list.</span></h2>
      <div class="pcards">
        {problems.map((p) => (
          <article class="pcard" data-stagger>
            <div class="pcard-img"><img src={`/placeholder-ill-${p.img}.svg`} alt="" /></div>
            <div class="pcard-body"><h5>{p.t}</h5><p class="muted">{p.d}</p></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- DARK PANEL COMPARISON -->
  <section class="pad">
    <div class="container panel-dark" data-stagger>
      <div class="pd-left">
        <h2 data-split-lines>Pay the share,<br />not the <span class="accent">person</span></h2>
        <a class="btn no-chip" href="#how">How it works</a>
      </div>
      <div class="pd-table" role="table" aria-label="Comparison">
        <div class="pd-col pd-old" role="rowgroup">
          <div class="pd-colh" role="columnheader">Without a shared registry</div>
          {compare.map(([k, a]) => <div class="pd-row" role="row"><span class="pd-k">{k}</span><span>{a}</span></div>)}
        </div>
        <div class="pd-col pd-new" role="rowgroup">
          <div class="pd-colh" role="columnheader">With {PROJECT_NAME}</div>
          {compare.map(([k, , b]) => <div class="pd-row" role="row"><span class="dot"></span><span>{b}</span></div>)}
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS DIAGRAM -->
  <section class="how sec-lg pad" id="how">
    <div class="container">
      <div class="center how-head">
        <h2 data-split-lines>How it works</h2>
        <p class="lead" data-stagger>One registry contract. One vault per share. No keys on any vault.</p>
      </div>
      <div class="diagram" data-diagram>
        <div class="dg-top">
          <div class="dg-logo" data-dg="logo"><span class="dg-mark">R</span></div>
          <div class="dg-vline" data-dg="vline"></div>
          <div class="dg-connector" data-dg="connector"></div>
          <div class="dg-branches">
            {['Payer', 'Agent', 'Member'].map((b) => (
              <div class="dg-branch"><span class="dg-tick"></span><span class="dg-pill" data-dg="pill">{b}</span><span class="dg-tick short"></span><span class="dg-dot" data-dg="dot"></span></div>
            ))}
          </div>
        </div>
        <div class="dg-engine" data-dg="engine">
          <div class="center">
            <h4>The registry contract</h4>
            <p class="muted">Records works, shares and splits. Moves money only by its rules.</p>
          </div>
          <div class="dg-cards">
            {steps.map((s) => (
              <div class="dg-card" data-dg="card">
                <span class="mono accent">{s.n}</span>
                <h5>{s.t}</h5>
                <p class="muted">{s.d}</p>
              </div>
            ))}
          </div>
        </div>
        <div class="dg-link" data-dg="link"><span class="dg-dot on"></span></div>
        <div class="dg-vaults" data-dg="vaults">
          <div class="dgv-text">
            <p class="dgv-t"><span class="mono accent">&#9679;</span> Share vaults</p>
            <p class="muted">Each share has its own payout account. It has zero access keys, so only the registry contract can move money out.</p>
            <span class="tag-ph">Example data</span>
          </div>
          <div class="dgv-orbs">
            {vaults.map((v, i) => (
              <div class="orb-wrap" data-dg="orb"><span class="orb" style={`--h:${i}`}></span><span class="mono orb-l">{v}</span><span class="mono orb-k">keys: 0</span></div>
            ))}
          </div>
        </div>
        <div class="dg-link" data-dg="link"><span class="dg-dot on"></span></div>
        <div class="dg-foot" data-dg="foot">
          <span class="tag-sim">Simulated</span>
          <p>Payers, statements and the catalog sale on this site are example data. Contract deployment to NEAR testnet is planned.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- AGENTS AUTO TABS -->
  <section class="agents sec-lg pad" id="agents">
    <div class="container agents-grid">
      <div class="agents-left">
        <p class="eyebrow">Agents</p>
        <h2 data-split-lines>Agents pay from capped allowances</h2>
        <p class="lead">Software can pay for music without holding the keys to anyone's money.</p>
      </div>
      <div class="tabs" data-tabs>
        {agentTabs.map((t, i) => (
          <button class={`tab ${i === 0 ? 'is-active' : ''}`} data-tab>
            <span class="tab-head"><svg class="tab-ico" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 .8l1.9 1.4 2.3-.2.7 2.2 1.9 1.4-.8 2.2.8 2.2-1.9 1.4-.7 2.2-2.3-.2L8 15.2l-1.9-1.4-2.3.2-.7-2.2-1.9-1.4.8-2.2-.8-2.2 1.9-1.4.7-2.2 2.3.2z" fill="currentColor"/><path d="M5.2 8.2l1.8 1.8 3.8-3.8" fill="none" stroke="#fff" stroke-width="1.5"/></svg><span class="tab-t">{t.t}</span><span class="mono tab-n">0{i + 1}</span></span>
            <span class="tab-body"><span class="tab-d">{t.d}</span></span>
            <span class="tab-bar"><span class="tab-prog" data-prog></span></span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- TESTIMONIAL PLACEHOLDER -->
  <section class="voices sec-lg pad">
    <div class="container">
      <div class="center">
        <p class="eyebrow">Voices</p>
        <h2 class="sec-h" data-split-lines>What people say <span class="accent">goes here</span></h2>
      </div>
      <div class="v-tabs" data-vtabs>
        {quotes.map((q, i) => <button class={`v-tab ${i === 0 ? 'is-active' : ''}`} data-vtab><img src={`/placeholder-logo-${q}.svg`} alt={`placeholder logo ${q}`} /></button>)}
      </div>
      <div class="v-stage">
        {quotes.map((q, i) => (
          <div class={`v-slide ${i === 0 ? 'is-active' : ''}`} data-vslide>
            <div class="v-quote">
              <span class="tag-ph">Placeholder quote {q}</span>
              <p class="v-text">A real quote goes here. <mark>We will not publish one</mark> until a real person says it and agrees to it.</p>
              <div class="v-foot"><div><p class="v-name">Name placeholder</p><p class="muted v-role">Role placeholder</p></div><a class="btn no-chip outline" href="#voices-placeholder">Read more</a></div>
            </div>
            <div class="v-photo"><img src="/placeholder-portrait.svg" alt="placeholder portrait" /></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- LIFECYCLE, PINNED HORIZONTAL -->
  <section class="life" id="lifecycle" data-life>
    <div class="life-pin">
      <div class="center life-head pad">
        <p class="eyebrow">The share lifecycle</p>
        <h2>Register. Mint. Pay. <span class="accent">Claim. Sell.</span></h2>
      </div>
      <div class="life-rail">
        <div class="life-line"><span class="life-fill" data-life-fill></span></div>
        <div class="life-track" data-life-track>
          {life.map((l) => (
            <article class="life-card">
              <span class="life-stem"></span>
              <div class="life-in">
                <span class="mono accent">{l.n}</span>
                <h4>{l.t}</h4>
                <span class="life-dash"></span>
                <p>{l.d}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST GRID -->
  <section class="trust sec-lg" id="trust">
    <h2 class="center pad sec-h" data-split-lines>Trust and privacy</h2>
    <div class="trust-grid">
      {trust.map((t) => (
        <div class="trust-cell" data-stagger>
          <svg class="trust-ico" viewBox="0 0 80 80" fill="none" stroke="currentColor" stroke-width="1">
            {t.icon === 'key' && <g><circle cx="40" cy="40" r="26" stroke-dasharray="3 4"/><rect x="28" y="36" width="24" height="18" rx="2"/><path d="M33 36v-6a7 7 0 0114 0v6"/><path d="M22 58L58 22" stroke="var(--amber)"/></g>}
            {t.icon === 'scale' && <g><path d="M40 16v48M24 64h32M18 30h44"/><path d="M18 30l-8 16h16zM62 30l-8 16h16z"/><circle cx="40" cy="16" r="3" fill="var(--amber)" stroke="none"/></g>}
            {t.icon === 'pause' && <g><circle cx="40" cy="40" r="24"/><circle cx="40" cy="40" r="32" stroke-dasharray="2 5"/><path d="M35 30v20M45 30v20" stroke="var(--amber)"/></g>}
            {t.icon === 'lock' && <g><rect x="16" y="20" width="30" height="40" rx="2"/><path d="M22 30h18M22 38h12M22 46h16"/><path d="M50 40h14" stroke-dasharray="2 3"/><text x="52" y="36" font-size="7" fill="var(--amber)" stroke="none" font-family="monospace">hash</text></g>}
          </svg>
          <h5>{t.t}</h5>
          <p class="muted">{t.d}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- RESOURCES -->
  <section class="res sec-lg pad">
    <div class="container">
      <h2 class="res-h">Read more</h2>
      <div class="res-grid">
        {resources.map((r, i) => (
          <a class="res-card" href={r.href} data-card-fade>
            <div class="res-thumb frame gridbg"><span class="tag-mono">{r.f}</span><span class="res-ph mono">placeholder-{r.k.toLowerCase()}</span></div>
            <div class="res-body"><span class="tag">{r.k}</span><p>{r.t}</p><span class="tag-ph">Placeholder link</span></div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  /* HERO: full bleed art, nav floats over it */
  .hero { position: relative; margin-top: -6.25rem; min-height: 44rem; display: flex; align-items: center; overflow: hidden; }
  .hero-art { position: absolute; inset: 0; }
  .hero-art img { width: 100%; height: 115%; object-fit: cover; object-position: 70% 50%; }
  .hero-shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(251,248,241,.85) 0%, rgba(251,248,241,.35) 50%, rgba(251,248,241,0) 75%); }
  .hero-body { position: relative; padding-top: 9rem; padding-bottom: 6rem; }
  .hero-tag { margin-bottom: 1.5rem; }
  .hero-h { max-width: 54rem; font-size: clamp(2.5rem, 4.6vw, 4rem); line-height: 1.1; letter-spacing: -.02em; color: var(--ink); }
  .hero-strong { display: block; font-weight: 600; }
  .hero-light { display: block; font-weight: 300; }
  .hero-sub { max-width: 36rem; margin-top: 1.25rem; font-size: 1.125rem; color: var(--ink2); }
  .hero-ctas { display: flex; align-items: center; gap: 1.75rem; margin-top: 2.25rem; flex-wrap: wrap; }
  .hero-link { color: var(--ink); }

  /* UPDATES: tinted band, soft cards */
  .updates { background: var(--bg2); }
  .updates-in { display: grid; grid-template-columns: 12rem 1fr; gap: 2rem; padding-top: 1.25rem; padding-bottom: 1.25rem; max-width: 90rem; margin: 0 auto; }
  .updates-head { display: flex; flex-direction: column; justify-content: space-between; }
  .updates-title { font-size: 1.25rem; font-weight: 500; line-height: 1.3; }
  .updates-nav { display: flex; gap: .5rem; }
  .sq { width: 2.25rem; height: 2.25rem; display: grid; place-items: center; border-radius: var(--r-xs); border: 0; background: var(--panel); color: var(--text); cursor: pointer; transition: background-color .2s, color .2s; }
  .sq:hover { background: var(--ink); color: #fff; }
  .updates-list { display: flex; gap: .875rem; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; scrollbar-width: none; }
  .updates-list::-webkit-scrollbar { display: none; }
  .up-card { flex: 0 0 calc((100% - 1.75rem) / 3); scroll-snap-align: start; display: grid; grid-template-columns: 9rem 1fr; gap: 1rem; padding: .5rem; border-radius: var(--r-sm); background: var(--bg); border: 1px solid #e5e2d9; transition: background-color .3s; }
  .up-card:hover { background: var(--panel); }
  .up-thumb { min-height: 6.5rem; border-radius: var(--r-xs); }
  .up-text { display: flex; flex-direction: column; gap: .4rem; font-size: .9rem; font-weight: 500; line-height: 1.3; padding: .25rem 0; }
  .up-text .link-arrow { margin-top: auto; font-size: .8rem; font-weight: 400; color: var(--muted); }

  /* LOGOS MARQUEE */
  .logos-h { font-size: 1.25rem; margin-bottom: 2.25rem; padding: 0 var(--gutter); }
  .marquee { position: relative; overflow: hidden; display: grid; gap: 1.25rem; }
  .marquee::before, .marquee::after { content: ''; position: absolute; top: 0; bottom: 0; width: 12rem; z-index: 2; pointer-events: none; }
  .marquee::before { left: 0; background: linear-gradient(90deg, var(--bg), transparent); }
  .marquee::after { right: 0; background: linear-gradient(270deg, var(--bg), transparent); }
  .mq-row { display: flex; width: max-content; }
  .mq-track { display: flex; gap: 3rem; padding-right: 3rem; animation: mq 40s linear infinite; }
  .mq-row.rev .mq-track { animation-direction: reverse; animation-duration: 48s; }
  .marquee:hover .mq-track { animation-play-state: paused; }
  @keyframes mq { from { transform: translateX(0); } to { transform: translateX(-100%); } }

  /* PROBLEM CARDS: white, hairline border, 20px radius, tinted art half */
  .sec-h { margin-bottom: 4rem; }
  .pcards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem; }
  .pcard { border: 1px solid var(--line); border-radius: var(--r-md); background: var(--panel); overflow: hidden; transition: border-color .4s; }
  .pcard-img { background: var(--band); aspect-ratio: 12 / 7; display: grid; place-items: center; overflow: hidden; border-bottom: 1px solid var(--line); }
  .pcard-img img { width: 100%; transition: transform .6s var(--ease-line); }
  .pcard:hover { border-color: var(--line3); }
  .pcard:hover .pcard-img img { transform: scale(1.06); }
  .pcard-body { padding: 1.75rem 1.5rem 2rem; text-align: center; display: grid; gap: .75rem; }
  .pcard-body p { font-size: .9rem; color: var(--muted); }

  /* DARK STATEMENT PANEL: the one dark block mid page */
  .panel-dark { display: grid; grid-template-columns: 1fr 1.05fr; gap: 3rem; align-items: center; padding: 5rem 4.5rem; border-radius: var(--r-md); background: var(--ink); color: #fff; position: relative; overflow: hidden; }
  .panel-dark::before { content: ''; position: absolute; inset: 0; background-image: radial-gradient(circle at 15% 120%, rgba(245,165,36,.18), transparent 45%), linear-gradient(to right, rgba(255,255,255,.035) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,.035) 1px, transparent 1px); background-size: auto, 40px 40px, 40px 40px; pointer-events: none; }
  .panel-dark > * { position: relative; }
  .pd-left h2 { margin-bottom: 2rem; }
  .pd-left .accent { color: var(--amber2); }
  .pd-table { display: grid; grid-template-columns: 1fr 1fr; font-size: .875rem; }
  .pd-col { border: 1px solid #3a362c; }
  .pd-old { border-radius: 10px 0 0 10px; border-right: 0; background: #1f1c15; color: #a7a295; margin: 1rem 0; }
  .pd-new { border-radius: 10px; border-color: var(--amber); background: #2a2214; color: #fff; }
  .pd-colh { padding: .75rem 1rem; border-bottom: 1px solid #3a362c; font-size: .8rem; }
  .pd-new .pd-colh { background: var(--amber); color: #2a1a00; border-color: var(--amber); border-radius: 9px 9px 0 0; font-weight: 600; }
  .pd-row { display: flex; gap: .6rem; align-items: center; padding: .7rem 1rem; border-bottom: 1px dashed #3a362c; min-height: 2.9rem; }
  .pd-row:last-child { border-bottom: 0; }
