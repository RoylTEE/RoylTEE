---
/**
 * Registry app shell: a persistent menu grouped by purpose (left sidebar on desktop, a drawer on
 * mobile), a breadcrumb, one period control, and tabs inside each area. No inline scripts: the menu
 * and the hash tabs run from src/scripts/shell.ts. The marketing landing page uses Base instead.
 */
import '@fontsource-variable/hanken-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import RegistryHeader from '../components/RegistryHeader.astro';
import { PROJECT_NAME } from '../consts';
import { GROUPS, AREAS, area as findArea } from '../data/ia';
import { REGISTRY, accountUrl } from '../data/testnet';
interface Props { area: string; tab?: string; title: string; intro?: string; crumb?: string; period?: boolean; description?: string }
const { area: areaKey, tab, title, intro, crumb, period = true, description } = Astro.props;
const area = findArea(areaKey);
const cspNonce = Astro.locals.cspNonce;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{`${title} . ${area.label} . ${PROJECT_NAME}`}</title>
    <meta name="description" content={description ?? intro ?? area.purpose} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {cspNonce && <script is:inline nonce={cspNonce} data-csp-nonce></script>}
  </head>
  <body class="app" data-shell>
    <a class="skip" href="#main">Skip to content</a>
    <header class="app-top">
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="app-menu" data-drawer-btn><span class="sr">Menu</span><span class="bars" aria-hidden="true"></span></button>
      <a href="/" class="app-logo" aria-label={`${PROJECT_NAME} home`}><Logo /></a>
      <span class="badge ok app-net">NEAR testnet</span>
      <span class="app-note">Live demo. Payments use Mock USDC.</span>
      <a class="btn sm app-cta" href="/member">Your shares</a>
    </header>
    <div class="app-body">
      <nav class="side" id="app-menu" aria-label="Registry menu" data-drawer>
        <div class="side-head"><span class="eyebrow">Menu</span><button class="btn sm quiet side-close" type="button" data-drawer-close>Close</button></div>
        {GROUPS.map((g) => (
          <div class="side-group">
            <p class="side-label">{g}</p>
            <ul>
              {AREAS.filter((a) => a.group === g).map((a) => (
                <li>
                  <a class="side-link" href={a.href} aria-current={a.key === area.key ? 'page' : undefined}>
                    <span class="side-t">{a.label}</span><span class="side-p">{a.purpose}</span>
                  </a>
                  {a.key === area.key && a.tabs.length > 0 && (
                    <ul class="side-sub">{a.tabs.map((t) => <li><a href={t.href} data-tab-link={t.href.includes('#') ? t.href.split('#')[1] : undefined} aria-current={t.key === tab ? 'page' : undefined}>{t.label}</a></li>)}</ul>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))}
        <div class="side-foot">
          <p class="caption">Registry contract</p>
          <a class="acct-link" href={accountUrl(REGISTRY)} target="_blank" rel="noopener">{REGISTRY}</a>
          <a class="side-back" href="/">Back to the project site</a>
        </div>
      </nav>
      <div class="side-backdrop" data-drawer-close hidden></div>
      <main id="main" class="app-main">
        <RegistryHeader area={area} tab={tab} title={title} intro={intro} crumb={crumb} period={period} />
        <div class="app-content"><slot /></div>
        <footer class="app-foot" id="notice">
          <span>Identity checks, payers and payer statements are Simulated. Nothing here is an investment product or legal advice.</span>
          <span class="app-foot-end">Built at NEAR HACKATHON</span>
        </footer>
      </main>
    </div>
  </body>
</html>
<script>import '../scripts/shell.ts';</script>
<style is:global>
  .skip { position: absolute; left: -999px; top: 0; z-index: 100; background: var(--ink); color: #fff; padding: .75rem 1rem; }
  .skip:focus { left: 1rem; top: 1rem; }
  body.app { --top: 3.5rem; --side: 16.5rem; }
  .app-top { position: sticky; top: 0; z-index: 50; height: var(--top); display: flex; align-items: center; gap: var(--s3); padding: 0 var(--s5); background: var(--surface); border-bottom: 1px solid var(--edge); }
  .app-logo { display: inline-flex; align-items: center; min-height: 2.75rem; text-decoration: none; }
  .app-note { font-size: var(--fs-14); color: var(--muted); }
  .app-cta { margin-left: auto; }
  .app-body { display: grid; grid-template-columns: var(--side) minmax(0, 1fr); min-height: calc(100vh - var(--top)); }
  .side { position: sticky; top: var(--top); align-self: start; height: calc(100vh - var(--top)); overflow-y: auto; background: var(--paper-2); border-right: 1px solid var(--edge); padding: var(--s5) var(--s3) var(--s5); display: flex; flex-direction: column; gap: var(--s5); }
  .side-head { display: none; }
  .side-label { font-family: var(--mono); font-size: var(--fs-12); letter-spacing: .06em; text-transform: uppercase; color: var(--dim); padding: 0 var(--s3) var(--s2); }
  .side ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .side-link { display: grid; gap: 1px; min-height: 2.75rem; align-content: center; padding: .45rem var(--s3); border-radius: var(--r-ctl); text-decoration: none; }
  .side-t { font-size: var(--fs-14); font-weight: 600; }
  .side-p { font-size: var(--fs-12); color: var(--dim); line-height: 1.35; }
  .side-link:hover { background: var(--surface); }
  .side-link[aria-current="page"] { background: var(--surface); }
  .side-sub { margin: 2px 0 var(--s2) var(--s4) !important; border-left: 1px solid var(--edge); }
  .side-sub a { display: flex; align-items: center; min-height: 2.5rem; padding: 0 var(--s3); font-size: var(--fs-14); color: var(--muted); text-decoration: none; margin-left: -1px; border-left: 2px solid transparent; }
  .side-sub a:hover { color: var(--text); }
  .side-sub a[aria-current="page"] { color: var(--text); font-weight: 600; }
  .side-foot { margin-top: auto; display: grid; gap: var(--s1); padding: var(--s4) var(--s3) 0; border-top: 1px solid var(--edge); }
  .side-back { display: inline-flex; align-items: center; min-height: 2.75rem; font-size: var(--fs-14); }
  .side-backdrop { display: none; }
  .app-main { min-width: 0; display: flex; flex-direction: column; }
  .app-content { padding: var(--s6) var(--s6) var(--s7); display: grid; gap: var(--s5); align-content: start; max-width: 88rem; width: 100%; flex: 1; }
  .app-content h2 { font-size: var(--fs-22); }
  .app-foot { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s3); padding: var(--s4) var(--s6); border-top: 1px solid var(--rule); font-size: var(--fs-12); color: var(--dim); }
  .app-foot-end { margin-left: auto; }
  .menu-btn { display: none; width: 2.75rem; height: 2.75rem; flex: none; border: 1px solid var(--edge); border-radius: var(--r-ctl); background: var(--surface); cursor: pointer; position: relative; }
  .bars, .bars::before, .bars::after { position: absolute; left: .8rem; right: .8rem; height: 2px; background: var(--ink); content: ''; }
  .bars { top: 50%; margin-top: -1px; } .bars::before { left: 0; right: 0; top: -6px; } .bars::after { left: 0; right: 0; top: 6px; }
  @media (max-width: 1199px) { .app-note { display: none; } }
  @media (max-width: 991px) {
    body.app { --side: min(20rem, 86vw); }
    .app-top { padding: 0 var(--s3); }
    .menu-btn { display: block; }
    .app-body { grid-template-columns: minmax(0, 1fr); }
    .side { position: fixed; z-index: 70; top: 0; left: 0; bottom: 0; height: 100%; width: var(--side); transform: translateX(-102%); visibility: hidden; transition: transform .2s ease, visibility 0s linear .2s; box-shadow: var(--shadow-2); padding-top: var(--s3); }
    body[data-menu="open"] .side { transform: none; visibility: visible; transition: transform .2s ease; }
    .side-head { display: flex; justify-content: space-between; align-items: center; padding: 0 var(--s3); }
    .side-backdrop { display: block; position: fixed; inset: 0; z-index: 60; background: rgba(23,21,15,.36); }
    .side-backdrop[hidden] { display: none; }
    body[data-menu="open"] { overflow: hidden; }
    .app-content { padding: var(--s4) var(--gutter) var(--s6); gap: var(--s4); }
    .app-foot { padding: var(--s4) var(--gutter); }
    .app-foot-end { margin-left: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .side { transition: none !important; } }
</style>
