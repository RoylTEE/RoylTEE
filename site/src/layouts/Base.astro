---
import '@fontsource-variable/inter-tight';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { PROJECT_NAME, PITCH } from '../consts';
interface Props { title?: string; description?: string; current?: string }
const { title = PROJECT_NAME, description = PITCH, current = '' } = Astro.props;
/* Set by src/middleware.ts on wallet sign in pages only. The browser hides the nonce attribute from the DOM; scripts read it from the element. */
const cspNonce = Astro.locals.cspNonce;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {cspNonce && <script is:inline nonce={cspNonce} data-csp-nonce></script>}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="testnet-bar" role="note">
      <span class="badge sim">Testnet</span>
      <span>NEAR testnet only. Payments use Mock USDC (testnet), a token with no value.</span>
    </div>
    <Nav current={current} />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
<style is:global>
  .skip { position: absolute; left: -999px; top: 0; z-index: 100; background: var(--ink); color: #fff; padding: .75rem 1rem; }
  .skip:focus { left: 1rem; top: 1rem; }
  .testnet-bar { display: flex; justify-content: center; align-items: center; gap: .75rem; padding: .45rem var(--gutter); background: var(--paper-2); border-bottom: 1px solid var(--rule); font-size: var(--fs-14); color: var(--muted); text-align: center; }
  @media (max-width: 479px) { .testnet-bar { font-size: var(--fs-12); justify-content: flex-start; text-align: left; } }
  .testnet-bar .mono { font-size: inherit; }
</style>
