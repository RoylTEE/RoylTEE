---
import Logo from './Logo.astro';
import { DASHBOARD_URL, WHITEPAPER_URL, SOURCE_URL, PROJECT_NAME } from '../consts';
const cols = [
  { h: 'Product', l: [['How it works', '/how-it-works'], ['Why NEAR', '/#near'], ['Security', '/security'], ['Auction', '/auction'], ['Verify', '/verify'], ['Demo dashboard', DASHBOARD_URL]] },
  { h: 'For you', l: [['Artists', '/artists'], ['Publishers and labels', '/publishers-and-labels'], ['Catalog buyers', '/catalog-buyers']] },
  { h: 'Learn', l: [['Whitepaper', WHITEPAPER_URL], ['Docs', '/docs'], ['FAQ and glossary', '/faq'], ['Updates', '/updates']] },
  { h: 'Company', l: [['About', '/about'], ['Help chat', '/help#chat'], ['Contact support', '/help#support'], ['Source code', SOURCE_URL]] },
];
---
<footer class="site-foot" id="notice">
  <div class="container">
    <div class="foot-top">
      <div class="foot-brand">
        <Logo />
        <p>A registry of music rights shares. Each share is an NFT that controls its own payout account.</p>
      </div>
      {cols.map((c) => (
        <div class="foot-col">
          <p class="eyebrow">{c.h}</p>
          <ul>{c.l.map(([t, h]) => <li><a href={h}>{t}</a></li>)}</ul>
        </div>
      ))}
    </div>
    <div class="foot-notice">
      <span class="badge sim">Simulated</span>
      <p>{PROJECT_NAME} runs on NEAR testnet only. Payments use Mock USDC (testnet), a mock token with no value. Identity checks, payers and payer statements are Simulated. This is not an investment product, and nothing here is legal advice.</p>
    </div>
    <div class="foot-bottom"><span>Built at <a href="https://nearhackathon.com" rel="noopener">NEAR HACKATHON</a></span><span class="mono foot-net">network: testnet</span></div>
  </div>
</footer>
<style>
  .site-foot { margin-top: var(--s9); border-top: 1px solid var(--edge); background: var(--surface); padding: var(--s8) 0 var(--s5); }
  .foot-top { display: grid; grid-template-columns: 1.4fr repeat(4, 1fr); gap: var(--s6); }
  .foot-brand { display: grid; gap: var(--s3); align-content: start; }
  .foot-brand p { font-size: var(--fs-14); color: var(--muted); max-width: 20rem; }
  .foot-col ul { list-style: none; margin: var(--s3) 0 0; padding: 0; display: grid; }
  .foot-col a { display: inline-flex; align-items: center; min-height: 2.25rem; font-size: var(--fs-14); color: var(--muted); text-decoration: none; }
  .foot-col a:hover { color: var(--text); text-decoration: underline; text-underline-offset: 3px; }
  .foot-notice { display: flex; gap: var(--s3); align-items: flex-start; margin-top: var(--s7); padding: var(--s4); border: 1px solid var(--rule); border-radius: var(--r-ctl); font-size: var(--fs-14); color: var(--muted); }
  .foot-bottom { display: flex; justify-content: space-between; gap: var(--s4); margin-top: var(--s5); font-size: var(--fs-12); color: var(--dim); }
  @media (max-width: 767px) {
    .foot-top { grid-template-columns: 1fr 1fr; }
    .foot-brand { grid-column: 1 / -1; }
    .foot-col a { min-height: 2.75rem; }
    .foot-notice { flex-direction: column; }
  }
  .foot-net { font-size: var(--fs-12); }
</style>
