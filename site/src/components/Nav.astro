---
import Logo from './Logo.astro';
import { DASHBOARD_URL } from '../consts';
interface Props { current?: string }
const { current = '' } = Astro.props;
/* Project site navigation. The registry app has its own menu (src/layouts/App.astro). */
const links = [
  { key: 'how', t: 'How it works', href: '/#how' },
  { key: 'trust', t: 'Real and Simulated', href: '/#trust' },
  { key: 'verify', t: 'Verify', href: '/verify' },
  { key: 'docs', t: 'Docs', href: '/docs' },
  { key: 'help', t: 'Help', href: '/help' },
];
---
<header class="site-head">
  <div class="container head-row">
    <a href="/" class="head-logo" aria-label="Home"><Logo /></a>
    <nav class="head-nav" aria-label="Main">
      {links.map((l) => <a href={l.href} aria-current={current === l.key ? 'page' : undefined}>{l.t}</a>)}
    </nav>
    <div class="head-end">
      <span class="badge ok net">NEAR testnet</span>
      <a class="btn primary head-cta" href={DASHBOARD_URL}>Open the registry</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-btn>
        <span class="sr">Menu</span><span class="bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>
  <nav class="mobile-menu" id="mobile-menu" aria-label="Main" hidden data-menu>
    {links.map((l) => <a href={l.href} aria-current={current === l.key ? 'page' : undefined}>{l.t}</a>)}
    <a class="btn primary" href={DASHBOARD_URL}>Open the registry</a>
  </nav>
</header>
<style>
  .site-head { position: sticky; top: 0; z-index: 40; background: rgba(247,246,242,.96); border-bottom: 1px solid var(--rule); }
  .head-row { display: flex; align-items: center; gap: var(--s6); min-height: 4rem; }
  .head-logo { text-decoration: none; display: inline-flex; min-height: 2.75rem; align-items: center; }
  .head-nav { display: flex; gap: var(--s1); }
  .head-nav a { display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0 .8rem; border-radius: var(--r-ctl); text-decoration: none; font-size: var(--fs-14); font-weight: 500; color: var(--muted); }
  .head-nav a:hover { color: var(--text); background: var(--paper-2); }
  .head-nav a[aria-current="page"] { color: var(--text); box-shadow: inset 0 -2px 0 var(--ink); border-radius: 0; }
  .head-end { margin-left: auto; display: flex; align-items: center; gap: var(--s3); }
  .menu-btn { display: none; width: 2.75rem; height: 2.75rem; border: 1px solid var(--edge); border-radius: var(--r-ctl); background: var(--surface); cursor: pointer; position: relative; }
  .bars, .bars::before, .bars::after { position: absolute; left: .8rem; right: .8rem; height: 2px; background: var(--ink); content: ''; }
  .bars { top: 50%; margin-top: -1px; } .bars::before { left: 0; right: 0; top: -6px; } .bars::after { left: 0; right: 0; top: 6px; }
  .menu-btn[aria-expanded="true"] .bars { background: transparent; }
  .menu-btn[aria-expanded="true"] .bars::before { top: 0; transform: rotate(45deg); }
  .menu-btn[aria-expanded="true"] .bars::after { top: 0; transform: rotate(-45deg); }
  .mobile-menu { display: grid; padding: var(--s2) var(--gutter) var(--s4); border-top: 1px solid var(--rule); background: var(--surface); box-shadow: var(--shadow-2); }
  .mobile-menu[hidden] { display: none; }
  .mobile-menu a:not(.btn) { display: flex; align-items: center; min-height: 3rem; border-bottom: 1px solid var(--rule); text-decoration: none; font-size: var(--fs-16); font-weight: 500; }
  .mobile-menu a[aria-current="page"] { box-shadow: inset 3px 0 0 var(--amber); padding-left: .75rem; }
  .mobile-menu .btn { margin-top: var(--s4); }
  @media (max-width: 991px) {
    .head-nav, .head-cta { display: none; }
    .menu-btn { display: block; }
  }
  @media (max-width: 479px) { .net { display: none; } }
</style>
<script>import '../scripts/nav.ts';</script>
