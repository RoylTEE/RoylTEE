---
import { DASHBOARD_URL } from '../consts';
import { REGISTRY, accountUrl } from '../data/testnet';
interface Props { tab: 'catalog' | 'member' | 'agents' | 'disputes' | 'share'; title: string; intro: string }
const { tab, title, intro } = Astro.props;
/* Registry sections, named by the job a member comes to do. */
const tabs = [
  { key: 'catalog', t: 'Catalog', href: DASHBOARD_URL },
  { key: 'member', t: 'Your shares', href: '/member' },
  { key: 'agents', t: 'Agents', href: '/agents' },
  { key: 'disputes', t: 'Disputes', href: '/disputes' },
];
---
<div class="reg-head">
  <div class="container">
    <div class="reg-title">
      <div class="stack">
        <p class="eyebrow">Registry <span aria-hidden="true">/</span> <a class="acct-link" href={accountUrl(REGISTRY)} target="_blank" rel="noopener">{REGISTRY}</a></p>
        <h1>{title}</h1>
        <p class="lead">{intro}</p>
      </div>
      <div class="period" role="group" aria-labelledby="period-l">
        <span class="label" id="period-l">Period</span>
        <div class="seg">
          <button type="button" aria-pressed="true" data-period="all">Since mint</button>
          <button type="button" aria-pressed="false" disabled title="Needs an event indexer. Roadmap.">By statement period</button>
        </div>
        <p class="caption" data-stamp>Not read yet</p>
      </div>
    </div>
    <nav class="reg-tabs" aria-label="Registry">
      {tabs.map((t) => <a href={t.href} aria-current={tab === t.key || (tab === 'share' && t.key === 'catalog') ? 'page' : undefined}>{t.t}</a>)}
    </nav>
  </div>
</div>
<style>
  .reg-head { background: var(--surface); border-bottom: 1px solid var(--edge); }
  .reg-title { display: flex; justify-content: space-between; align-items: flex-end; gap: var(--s6); padding: var(--s6) 0 var(--s5); flex-wrap: wrap; }
  .reg-title h1 { font-size: var(--fs-36); }
  .period { display: grid; gap: .4rem; justify-items: start; }
  .seg { display: inline-flex; border: 1px solid var(--edge); border-radius: var(--r-ctl); overflow: hidden; }
  .seg button { min-height: 2.5rem; padding: 0 .9rem; border: 0; background: var(--surface); font: inherit; font-size: var(--fs-14); font-weight: 600; color: var(--muted); cursor: pointer; }
  .seg button + button { border-left: 1px solid var(--edge); }
  .seg button[aria-pressed="true"] { background: var(--ink); color: #fff; }
  .seg button:disabled { cursor: not-allowed; color: var(--dim); background: var(--surface-2); }
  .reg-tabs { display: flex; gap: var(--s1); overflow-x: auto; margin-bottom: -1px; }
  .reg-tabs a { display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0 var(--s4); text-decoration: none; font-size: var(--fs-14); font-weight: 600; color: var(--muted); border-bottom: 2px solid transparent; white-space: nowrap; }
  .reg-tabs a:hover { color: var(--text); }
  .reg-tabs a[aria-current="page"] { color: var(--text); border-bottom-color: var(--ink); }
  @media (max-width: 767px) { .reg-title { padding: var(--s5) 0 var(--s4); gap: var(--s4); } .seg button { min-height: 2.75rem; } }
</style>
