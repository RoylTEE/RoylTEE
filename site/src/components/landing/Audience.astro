---
const cards = [
  { img: 'card-artists', who: 'Artists and songwriters', pain: 'Your share is a line in records you do not keep.', help: 'Your share is an NFT with its own payout account. Check the split on record, see what it earned and claim it. Only the current holder can.', href: '/artists', cta: 'For artists', alt: 'Flat retro illustration: a guitar amplifier on a cliff, with a glowing music note crystal hovering above it in a beam of light.' },
  { img: 'card-publishers', who: 'Publishers', pain: 'You and the other rightholders each keep a copy of the split, and the copies can disagree.', help: 'One split sheet on the registry. A share registered by someone else waits for your approval, and its money is held, not paid, until you sign.', href: '/publishers-and-labels#publishers', cta: 'For publishers', alt: 'Flat retro illustration: a filing cabinet with open drawers of shares under a beam of light, a music note crystal above it.' },
  { img: 'card-labels', who: 'Labels', pain: 'Selling a catalog means telling every payer to pay the new owner.', help: 'Transfer the share and the payout address stays the same. Unclaimed money goes with it, and the seller keeps no key. Or sell by sealed-bid auction in a TEE.', href: '/publishers-and-labels#labels', cta: 'For labels', alt: 'Flat retro illustration: a giant vinyl record standing on a cliff edge like a monolith, with small lit markers floating around it.' },
  { img: 'card-buyers', who: 'Catalog buyers', pain: 'The records you can check belong to other parties.', help: 'Confirm the share, the payout account, that the seller kept no key, and that unclaimed money came along. Read it from a public node, no wallet needed.', href: '/catalog-buyers', cta: 'For catalog buyers', alt: 'Flat retro illustration: two vintage microphones on a cliff passing sealed envelopes toward a domed vault across a chasm.' },
];
---
<section class="l-sec" id="audience">
  <div class="container">
    <div class="l-head">
      <p class="l-eyebrow">Who it is for</p>
      <h2 class="l-h2">Four people, one record</h2>
      <p class="lead">Each of them works from someone else's copy today. Here is the pain, and what the registry changes.</p>
    </div>
    <ul class="cards">
      {cards.map((c) => (
        <li class="card">
          <img src={`/art/${c.img}.webp`} width="1200" height="896" alt={c.alt} loading="lazy" decoding="async" />
          <div class="body">
            <p class="l-eyebrow">{c.who}</p>
            <h3>{c.pain}</h3>
            <p class="muted">{c.help}</p>
            <a class="l-textlink" href={c.href}>{c.cta}</a>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--s5); }
  .card { display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--edge); border-radius: var(--r-card); box-shadow: var(--shadow-1); overflow: hidden; }
  .card img { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; background: var(--night); }
  .body { display: grid; gap: var(--s2); align-content: start; padding: var(--s5); flex: 1; }
  .body .l-eyebrow { color: var(--amber-ink); }
  h3 { font-size: var(--fs-18); font-weight: 600; line-height: 1.25; }
  .body p.muted { font-size: var(--fs-14); line-height: 1.55; }
  .body a { margin-top: auto; justify-self: start; }
  @media (max-width: 1199px) { .cards { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 639px) { .cards { grid-template-columns: 1fr; } .body { padding: var(--s4); } }
</style>
