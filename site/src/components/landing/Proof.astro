---
import { PROOF, AUCTION_FACTS } from '../../data/landing';
---
<section class="proof" id="proof">
  <div class="container">
    <div class="l-head">
      <p class="l-eyebrow">Proof, not promises</p>
      <h2 class="l-h2">Numbers you can recount yourself</h2>
      <p class="lead">These figures are counted from the recorded evidence files in the repository when the site is built. Each one links to the page that shows the detail.</p>
    </div>
    <ul class="stats">
      {PROOF.map((p) => (
        <li>
          <p class="v mono">{p.value}</p>
          <p class="lab">{p.label}</p>
          <p class="muted n">{p.note}</p>
          <a class="l-textlink" href={p.href}>{p.cta}</a>
        </li>
      ))}
    </ul>
    <p class="caption foot">The sealed-bid auction ran on contract <a class="acct-link" href={AUCTION_FACTS.accountHref} target="_blank" rel="noopener">{AUCTION_FACTS.account}</a>: {AUCTION_FACTS.bids} bids, settled {AUCTION_FACTS.settledAt} at {AUCTION_FACTS.price} mUSDC (Simulated money).</p>
  </div>
</section>
<style>
  .proof { padding: var(--s9) 0; background: var(--paper-2); border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .stats { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); border: 1px solid var(--edge); border-radius: var(--r-card); background: var(--surface); box-shadow: var(--shadow-1); overflow: hidden; }
  .stats li { display: grid; gap: var(--s2); align-content: start; padding: var(--s5); border-right: 1px solid var(--rule); }
  .stats li:last-child { border-right: 0; }
  .v { font-size: clamp(2rem, 1.5rem + 1.6vw, 2.75rem); font-weight: 500; letter-spacing: -.04em; line-height: 1; color: var(--ink); }
  .lab { font-weight: 600; font-size: var(--fs-14); line-height: 1.35; }
  .n { font-size: var(--fs-14); line-height: 1.5; }
  .foot { margin-top: var(--s4); }
  @media (max-width: 1023px) { .stats { grid-template-columns: repeat(2, 1fr); } .stats li:nth-child(2) { border-right: 0; } .stats li:nth-child(-n+2) { border-bottom: 1px solid var(--rule); } }
  @media (max-width: 599px) { .proof { padding: var(--s7) 0; } .stats { grid-template-columns: 1fr; } .stats li { border-right: 0; border-bottom: 1px solid var(--rule); } .stats li:last-child { border-bottom: 0; } }
</style>
