---
import { EXPLORER } from '../../data/testnet';
import { AUCTION } from '../../data/auction';
const passed = AUCTION.verify.checks.filter((c) => c.verdict === 'PASS').length;
const total = AUCTION.verify.checks.length;
const items = [
  { t: 'Access keys', job: 'Nobody can move a share outside the rules', d: 'A NEAR account with no keys is locked: nobody can sign for it. Each vault was created with none and none was ever added, so nobody, including us, can move a share around the contract. Only the vault\'s own code can pay out, and it takes orders only from the registry. A public check finds no keys on any of the 15 vaults. Payment agents get a limited key too, one that can only make payments inside set limits.', core: true },
  { t: 'Named accounts', job: 'Every vault is readable', d: 'Each share vault is a named account, not a string of random characters. A label executive can look it up in a public explorer and see who holds it.' },
  { t: 'Standards', job: 'Shares and money use published formats', d: 'Shares and the mock dollar follow standards NEAR publishes for NFTs and tokens, so tools that follow them can read both.' },
  { t: 'OutLayer secure hardware', job: 'Sealed bids, checked on chain', d: `The auction settles through OutLayer, which runs a program in secure hardware for a NEAR contract. An independent checker confirmed its proof against the chain: ${passed} of ${total} checks passed. Fairness still rests on OutLayer as the one that runs it.` },
  { t: 'Public explorer', job: 'Anyone can verify', d: 'Every account and transaction behind this page opens on the public nearblocks testnet explorer. You need no login and no wallet.', link: [EXPLORER, 'Open the explorer'] },
];
---
<section class="l-sec near" id="near">
  <div class="container">
    <div class="l-split head">
      <div class="l-head">
        <p class="l-eyebrow">Why NEAR</p>
        <h2 class="l-h2">What NEAR does for RoylTEE, job by job</h2>
        <p class="lead">We did not pick NEAR for the name. Each feature below does one concrete job in the registry, and you can check each one yourself.</p>
      </div>
      <figure class="motif">
        <img src="/art/near-vault.webp" width="470" height="388" alt="Flat retro illustration: a domed vault painted with the NEAR mark under a beam of light, with a music note crystal above it." loading="lazy" decoding="async" />
      </figure>
    </div>
    <ul class="items">
      {items.map((i) => (
        <li class={i.core ? 'core' : ''}>
          <p class="l-eyebrow">{i.t}</p>
          <h3>{i.job}</h3>
          <p class="muted">{i.d}</p>
          {i.link && <a class="l-textlink" href={i.link[0]} target="_blank" rel="noopener">{i.link[1]}</a>}
        </li>
      ))}
    </ul>
    <p class="more"><a class="l-textlink" href="/security">Security, in full, including what is still open</a></p>
  </div>
</section>
<style>
  .near { background: var(--surface-2); }
  .head { align-items: end; }
  .motif { margin: 0; justify-self: end; max-width: 26rem; border-radius: var(--r-card); overflow: hidden; border: 1px solid var(--edge); background: var(--night); box-shadow: var(--shadow-1); }
  .motif img { width: 100%; height: auto; }
  .items { list-style: none; margin: var(--s7) 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s4); }
  .items li { display: grid; gap: var(--s2); align-content: start; padding: var(--s5); background: var(--surface); border: 1px solid var(--edge); border-radius: var(--r-card); box-shadow: var(--shadow-1); }
  .items li.core { grid-column: span 2; border-color: var(--ink); border-width: 2px; }
  h3 { font-size: var(--fs-18); font-weight: 600; line-height: 1.25; }
  .items p.muted { font-size: var(--fs-14); line-height: 1.6; }
  .items a { justify-self: start; }
  .more { margin-top: var(--s5); }
  @media (max-width: 1023px) { .items { grid-template-columns: repeat(2, 1fr); } .motif { justify-self: start; } }
  @media (max-width: 639px) { .items { grid-template-columns: 1fr; } .items li.core { grid-column: auto; } }
</style>
