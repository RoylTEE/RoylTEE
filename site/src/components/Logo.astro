---
import { PROJECT_NAME } from '../consts';
---
<span class="logo"><span class="logo-word">{PROJECT_NAME}</span><span class="logo-mark" aria-hidden="true"></span></span>
<style>
  /* Text wordmark in our own type until a final logo exists. */
  .logo { display: inline-flex; align-items: baseline; gap: .2rem; color: inherit; }
  .logo-word { font-family: var(--mono); font-weight: 700; font-size: 1.25rem; letter-spacing: -.05em; line-height: 1; }
  .logo-mark { width: .36rem; height: .36rem; background: var(--amber); }
</style>
